{
  "name": "harness",
  "version": "2.2.0",
  "description": "Create a compact task-local coding-agent harness with canonical documentation routes and minimal check-only Bash verification.",
  "license": "MIT",
  "author": "tungxuan1656",
  "publisher": "tungxuan1656",
  "repository": "https://github.com/tungxuan1656/harness-slim",
  "languages": [
    "en"
  ],
  "compatibility": {
    "agents": [
      "claude-code",
      "codex-cli",
      "cursor",
      "windsurf",
      "generic"
    ]
  },
  "entryPoint": "SKILL.md",
  "references": [
    "references/memory-persistence-pattern.md",
    "references/context-engineering-pattern.md",
    "references/multi-agent-pattern.md",
    "references/gotchas.md",
    "references/gotchas-full.md",
    "references/migration-v2.md",
    "references/task-ids.md"
  ],
  "triggers": [
    "harness engineering",
    "coding agent harness",
    "agent reliability",
    "session continuity",
    "verification workflow",
    "scope control",
    "lifecycle management",
    "AGENTS.md",
    "init.sh",
    "monorepo verification",
    "multi-agent coordination",
    "context engineering",
    "task decomposition",
    "task tracking",
    "tasks/index.md",
    "canonical documentation"
  ],
  "bundled": {
    "scripts": [
      "scripts/task-ready.mjs",
      "scripts/task-id.mjs"
    ],
    "templates": [
      "templates/agents.md",
      "templates/task-template.md",
      "templates/task-index.md",
      "templates/init.sh"
    ]
  }
}
